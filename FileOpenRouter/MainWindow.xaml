<Window x:Class="FileOpenRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="兜底程序：" />
            <TextBox x:Name="FallbackProgramTextBox"
                     Grid.Column="1"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="2"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Padding="10,5"
                    Content="选择程序"
                    Click="ChooseFallbackProgram_Click" />
        </Grid>

        <DataGrid x:Name="RulesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用"
                                        Width="60"
                                        Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="规则名称"
                                    Width="150"
                                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="文件夹路径"
                                    Width="*"
                                    Binding="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="打开程序路径"
                                    Width="*"
                                    Binding="{Binding Program, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="10,5"
                    Content="新增规则"
                    Click="AddRule_Click" />
            <Button MinWidth="100"
                    Margin="0,0,24,0"
                    Padding="10,5"
                    Content="删除选中规则"
                    Click="DeleteSelectedRule_Click" />
            <Button MinWidth="100"
                    Margin="0,0,8,0"
                    Padding="10,5"
                    Content="选择文件夹"
                    Click="ChooseRuleFolder_Click" />
            <Button MinWidth="100"
                    Margin="0,0,24,0"
                    Padding="10,5"
                    Content="选择程序"
                    Click="ChooseRuleProgram_Click" />
            <Button MinWidth="100"
                    Margin="0"
                    Padding="10,5"
                    Content="保存配置"
                    Click="SaveConfig_Click" />
        </WrapPanel>
    </Grid>
</Window>
