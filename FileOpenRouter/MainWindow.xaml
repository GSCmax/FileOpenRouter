<Window x:Class="FileOpenRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="700"
        Width="1120"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="HighLightBrush" Color="#D6E4F0"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#f8491e"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#707070"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HighLightBrush}"
                Margin="0,0,0,10">
            <StackPanel Margin="6,6,6,0">
                <TextBlock FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,6"
                           Text="文件打开方式路由器" />
                <TextBlock TextWrapping="Wrap"
                           LineHeight="22">
                    <Run Text="1. 本程序不是解压软件、阅读器或编辑器，而是“打开方式路由器”。它只负责判断文件路径，并调用你配置的外部程序。" />
                    <LineBreak />
                    <Run Text="2. 请先选择一个真实存在的兜底程序。当前文件未命中任何规则时，本程序会使用该兜底程序打开文件，按住 Shift键 打开文件时，也会强制使用兜底程序。" />
                    <LineBreak />
                    <Run Text="3. 请将本程序设置为对应文件类型的默认打开程序。设置完成后，双击打开这些文件时，本程序会自动根据文件所在目录，将其转交给指定程序打开（目录越具体则优先级越高）。" />
                    <LineBreak />
                    <Run Text="4. 可以复制多份本程序并重新命名，例如 FileOpenRouter_压缩包.exe、FileOpenRouter_pdf.exe，不同名称的程序会使用不同配置文件，适合分别管理 压缩包、PDF 等不同文件类型。" />
                    <LineBreak />
                    <Run Foreground="{DynamicResource DangerBrush}" Text="5. 注意：兜底程序不要选择本程序自身，否则可能造成循环调用。"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="兜底程序：" />
            <TextBox x:Name="FallbackProgramTextBox"
                     Grid.Column="1"
                     BorderBrush="{DynamicResource BorderBrush}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="2"
                    MinWidth="100"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    Content="选择程序"
                    Click="ChooseFallbackProgram_Click" />
        </Grid>

        <DataGrid x:Name="RulesGrid"
                  Grid.Row="2"
                  BorderBrush="{DynamicResource BorderBrush}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用"
                                        Width="60"
                                        Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="规则名称"
                                    Width="150"
                                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="文件夹路径"
                                    Width="*"
                                    Binding="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="打开程序路径"
                                    Width="*"
                                    Binding="{Binding Program, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Right">
            <Button MinWidth="100"
                    Margin="0,0,10,0"
                    Padding="10,5"
                    Content="新增规则"
                    Click="AddRule_Click" />
            <Button MinWidth="100"
                    Margin="0,0,30,0"
                    Padding="10,5"
                    Content="删除选中规则"
                    Click="DeleteSelectedRule_Click" />
            <Button MinWidth="100"
                    Margin="0,0,10,0"
                    Padding="10,5"
                    Content="选择文件夹"
                    Click="ChooseRuleFolder_Click" />
            <Button MinWidth="100"
                    Margin="0,0,30,0"
                    Padding="10,5"
                    Content="选择程序"
                    Click="ChooseRuleProgram_Click" />
            <Button MinWidth="100"
                    Margin="0"
                    Padding="10,5"
                    Content="保存配置"
                    Click="SaveConfig_Click" />
        </WrapPanel>
    </Grid>
</Window>
